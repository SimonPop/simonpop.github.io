---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SparkCard from '../../components/SparkCard.astro';
import SparkOrb from '../../components/SparkOrb.astro';
import { SPARK_PALETTE } from '../../lib/spark-art';
import { THEME_META } from '../../lib/themes';

const sparks = (await getCollection('sparks', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const themesInUse = new Set(sparks.map((spark) => spark.data.theme));
const themeEntries = (Object.entries(THEME_META) as [keyof typeof THEME_META, (typeof THEME_META)[keyof typeof THEME_META]][]).filter(
	([key]) => themesInUse.has(key),
);

const heroSpark = sparks.length > 0 ? sparks[Math.floor(Math.random() * sparks.length)] : undefined;
const heroSeed = heroSpark ? `hero-${heroSpark.id}` : 'hero-spark';
---

<BaseLayout title="Sparks — Simon Popelier" description="Short-form notes and ideas.">
	<h1>Sparks</h1>
	<p class="sparks-intro">Short-form notes.</p>

	<div class="spark-random-hero">
		<SparkOrb seed={heroSeed} colors={SPARK_PALETTE} size={148} ariaLabel="Jump to a random spark" />
		<div class="spark-random-hero-text">
			<p class="spark-random-label">Not sure where to start?</p>
			<p class="spark-random-hint">Click the spark to jump to a random one.</p>
		</div>
	</div>

	<div class="sparks-controls">
		<div class="theme-filters" role="group" aria-label="Filter by theme">
			<button class="filter-chip" data-theme-filter="all" aria-pressed="true">All</button>
			{
				themeEntries.map(([key, meta]) => (
					<button class="filter-chip" data-theme-filter={key} aria-pressed="false">
						{meta.label}
					</button>
				))
			}
		</div>
	</div>

	<div class="spark-grid" id="spark-grid">
		{
			sparks.map((spark) => (
				<SparkCard slug={spark.id} title={spark.data.title} date={spark.data.date} theme={spark.data.theme} />
			))
		}
	</div>
	{sparks.length === 0 && <p class="sparks-empty">No sparks published yet.</p>}
</BaseLayout>

<script>
	const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
	const randomBtn = document.getElementById('random-spark');

	chips.forEach((chip) => {
		chip.addEventListener('click', () => {
			const theme = chip.dataset.themeFilter;
			chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
			document.querySelectorAll<HTMLAnchorElement>('.spark-card').forEach((card) => {
				const match = theme === 'all' || card.dataset.theme === theme;
				card.style.display = match ? '' : 'none';
			});
		});
	});

	randomBtn?.addEventListener('click', () => {
		const visible = Array.from(document.querySelectorAll<HTMLAnchorElement>('.spark-card')).filter(
			(card) => card.style.display !== 'none',
		);
		if (visible.length === 0) return;
		const pick = visible[Math.floor(Math.random() * visible.length)];
		window.location.href = pick.href;
	});
</script>
