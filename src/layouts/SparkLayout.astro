---
import BaseLayout from './BaseLayout.astro';
import SparkOrb from '../components/SparkOrb.astro';
import { THEME_META, type ThemeKey } from '../lib/themes';
import { SPARK_PALETTE } from '../lib/spark-art';

interface Props {
	slug: string;
	title: string;
	date: Date;
	theme: ThemeKey;
	tags?: string[];
	article?: string;
	otherSlugs?: string[];
	js?: string[];
}

const { slug, title, date, theme, tags = [], article, otherSlugs = [], js = [] } = Astro.props;
const themeMeta = THEME_META[theme];
const formattedDate = date.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
});
---

<BaseLayout title={`${title} — Simon Popelier`} description={title}>
	<article class="spark">
		<header class="spark-header">
			<span class="theme-badge">{themeMeta.label}</span>
			<h1>{title}</h1>
			<p class="article-meta">
				<time datetime={date.toISOString()}>{formattedDate}</time>
				{tags.length > 0 && <span> · {tags.join(', ')}</span>}
			</p>
		</header>
		<div class="article-body spark-body">
			<slot />
		</div>
		{
			article && (
				<a class="spark-article-link" href={`/articles/${article}/`}>
					Read the full article →
				</a>
			)
		}
		{
			otherSlugs.length > 0 && (
				<div class="spark-next" data-other-slugs={JSON.stringify(otherSlugs)}>
					<SparkOrb seed={`next-${slug}`} colors={SPARK_PALETTE} size={130} ariaLabel="Jump to a random spark" />
					<p class="spark-next-hint">Next random spark</p>
				</div>
			)
		}
	</article>
	{js.length > 0 && <script src="https://cdn.jsdelivr.net/npm/d3@7" is:inline></script>}
	{js.map((file) => <script src={`/js/${file}`} is:inline></script>)}
</BaseLayout>

<script>
	const wrap = document.querySelector<HTMLElement>('.spark-next');
	const btn = wrap?.querySelector('.spark-orb');
	btn?.addEventListener('click', () => {
		const slugs = JSON.parse(wrap?.dataset.otherSlugs ?? '[]') as string[];
		if (slugs.length === 0) return;
		const pick = slugs[Math.floor(Math.random() * slugs.length)];
		window.location.href = `/sparks/${pick}/`;
	});
</script>
