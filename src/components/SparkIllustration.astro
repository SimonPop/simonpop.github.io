---
/*
 * Animated spark, painted on a <canvas>. Only worth its JavaScript for the one
 * hero per page — every static thumbnail should use SparkGlyph instead, which
 * renders the identical figure as build-time SVG.
 */
interface Props {
	seed: string;
	color: string;
	size?: number;
	rays?: number;
	colors?: string[];
}

const { seed, color, size = 220, rays, colors } = Astro.props;
const id = `spark-${seed.replace(/[^a-z0-9]/gi, '-')}`;
---

<canvas
	class="spark-illustration"
	id={id}
	width={size}
	height={size}
	style={`width: ${size}px; height: ${size}px;`}
	data-seed={seed}
	data-color={color}
	data-colors={colors ? colors.join(',') : ''}
	data-rays={rays ?? ''}
	role="img"
	aria-label="Procedurally generated illustration"
></canvas>

<script>
	import {
		buildParams,
		clampDistance,
		hexToRgb,
		DIST_PULSE_RANGE,
		SIZE_PULSE_RANGE,
		type SparkParams,
	} from '../lib/spark-art';

	function lerp(a: number, b: number, t: number) {
		return a + (b - a) * t;
	}

	function paint(
		ctx: CanvasRenderingContext2D,
		size: number,
		rgb: string,
		params: SparkParams,
		rotation: number,
		pulseTime: number,
	) {
		const cx = size / 2;
		const cy = size / 2;
		ctx.clearRect(0, 0, size, size);

		for (const ray of params.rays) {
			const angle = params.baseAngle + rotation * ray.speedFactor + ray.angleOffset;
			const length = size * ray.length;
			const curve = size * ray.curve;

			const tipX = cx + Math.cos(angle) * length;
			const tipY = cy + Math.sin(angle) * length;
			const perp = angle + Math.PI / 2;
			const ctrlDist = length * 0.55;
			const ctrl1X = cx + Math.cos(angle) * ctrlDist + Math.cos(perp) * curve;
			const ctrl1Y = cy + Math.sin(angle) * ctrlDist + Math.sin(perp) * curve;
			const ctrl2X = cx + Math.cos(angle) * ctrlDist - Math.cos(perp) * curve;
			const ctrl2Y = cy + Math.sin(angle) * ctrlDist - Math.sin(perp) * curve;

			const grad = ctx.createLinearGradient(cx, cy, tipX, tipY);
			grad.addColorStop(0, `rgba(${rgb}, 0.55)`);
			grad.addColorStop(1, `rgba(${rgb}, 0)`);

			ctx.beginPath();
			ctx.moveTo(cx, cy);
			ctx.quadraticCurveTo(ctrl1X, ctrl1Y, tipX, tipY);
			ctx.quadraticCurveTo(ctrl2X, ctrl2Y, cx, cy);
			ctx.fillStyle = grad;
			ctx.fill();

			for (const particle of ray.particles) {
				const particleAngle = params.baseAngle + rotation * particle.speedFactor + ray.angleOffset + particle.angleJitter;
				const sizePulse = 1 + SIZE_PULSE_RANGE * Math.sin(pulseTime * particle.sizePulseSpeed + particle.sizePulsePhase);
				const displayRadius = particle.radius * sizePulse;
				const distPulse = 1 + DIST_PULSE_RANGE * Math.sin(pulseTime * particle.distPulseSpeed + particle.distPulsePhase);
				const rawDist = length * particle.distFactor * distPulse;
				const safeMax = Math.max(size / 2 - particle.maxRadius - 1.5, 0);
				const dist = clampDistance(rawDist, safeMax);
				const px = cx + Math.cos(particleAngle) * dist;
				const py = cy + Math.sin(particleAngle) * dist;
				ctx.beginPath();
				ctx.arc(px, py, displayRadius, 0, Math.PI * 2);
				ctx.fillStyle = `rgba(${rgb}, ${particle.alpha})`;
				ctx.fill();
			}
		}

		const coreRadius = size * 0.1;
		const coreGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, coreRadius);
		coreGrad.addColorStop(0, `rgba(${rgb}, 0.95)`);
		coreGrad.addColorStop(0.7, `rgba(${rgb}, 0.5)`);
		coreGrad.addColorStop(1, `rgba(${rgb}, 0)`);
		ctx.beginPath();
		ctx.arc(cx, cy, coreRadius, 0, Math.PI * 2);
		ctx.fillStyle = coreGrad;
		ctx.fill();
	}

	function setupSpark(canvas: HTMLCanvasElement) {
		const seed = canvas.dataset.seed ?? 'spark';
		const color = canvas.dataset.color ?? '#4a5fd9';
		const colorList = (canvas.dataset.colors ?? '')
			.split(',')
			.map((c) => c.trim())
			.filter(Boolean);
		const rayOverride = canvas.dataset.rays ? Number(canvas.dataset.rays) : undefined;
		const size = canvas.width;

		const palette = (colorList.length > 0 ? colorList : [color]).map(hexToRgb);

		const dpr = window.devicePixelRatio || 1;
		canvas.width = size * dpr;
		canvas.height = size * dpr;
		const ctx = canvas.getContext('2d');
		if (!ctx) return;
		ctx.scale(dpr, dpr);

		const params = buildParams(seed, rayOverride);
		const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		const initialRgb = palette[0];
		paint(ctx, size, `${initialRgb.r}, ${initialRgb.g}, ${initialRgb.b}`, params, 0, 0);
		if (reduceMotion) return;

		let rotation = 0;
		let colorPhase = 0;
		let pulseTime = 0;
		const loop = () => {
			rotation += 0.0015;
			pulseTime += 0.03;
			let rgb = `${palette[0].r}, ${palette[0].g}, ${palette[0].b}`;
			if (palette.length > 1) {
				colorPhase += 0.0025;
				const cycle = colorPhase % palette.length;
				const index = Math.floor(cycle);
				const t = cycle - index;
				const a = palette[index];
				const b = palette[(index + 1) % palette.length];
				rgb = `${lerp(a.r, b.r, t)}, ${lerp(a.g, b.g, t)}, ${lerp(a.b, b.b, t)}`;
			}
			paint(ctx, size, rgb, params, rotation, pulseTime);
			requestAnimationFrame(loop);
		};
		requestAnimationFrame(loop);
	}

	document.querySelectorAll<HTMLCanvasElement>('canvas.spark-illustration').forEach(setupSpark);
</script>
